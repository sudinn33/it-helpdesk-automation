    },
    {
      "parameters": {
        "model": "llama3.2:3b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmOllama",
      "typeVersion": 1,
      "position": [
        864,
        48
      ],
      "id": "a5e06f40-15b6-4ee7-8a0e-11f5c28adf13",
      "name": "Ollama Model"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ticket = $('Code in JavaScript').item.json;\nconst reply = ($json.text ?? $json.output ?? '').toString();\n\nconst priorityMatch = reply.match(/priority\\s*:\\s*(high|medium|low)/i);\nconst fixMatch = reply.match(/first fix\\s*:\\s*(.+)/i);\n\nconst priority = priorityMatch\n  ? priorityMatch[1].charAt(0).toUpperCase() + priorityMatch[1].slice(1).toLowerCase()\n  : ticket.priority;\n\nconst fix = fixMatch && fixMatch[1].trim().length > 5\n  ? fixMatch[1].trim().slice(0, 250)\n  : ticket.suggested_fix;\n\nreturn { json: { ...ticket, priority, suggested_fix: fix } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        128
      ],
