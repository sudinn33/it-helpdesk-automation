        "jsCode": "const typeKey = Object.keys($json).find(k => k.toLowerCase().replace(/\\s/g, '') === 'issuetype');\nconst type = typeKey ? $json[typeKey] : '';\n\nreturn {\n  json: {\n    ticket_id: 'TKT-' + Date.now(),\n    submitted_at: $json.submittedAt,\n    name: $json['Name'],\n    department: $json['Department'],\n    issue_type: type,\n    description: $json['Description'],\n    priority: 'Medium',\n    suggested_fix: 'Review manually',\n    status: 'Open'\n  }\n};"
